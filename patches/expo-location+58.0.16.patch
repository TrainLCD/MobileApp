+    _trainLCDInBackground, _locationManager.pausesLocationUpdatesAutomatically,
+    NSProcessInfo.processInfo.lowPowerModeEnabled, _locationManager.distanceFilter,
+    _trainLCDHeartbeatInterval, _trainLCDHeartbeatTimeout);
+}
