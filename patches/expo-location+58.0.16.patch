+// TrainLCD: keep the configured foreground and power-saving distance filters.
+#ifndef EX_TRAINLCD_LOCATION_POLICY_H
+#define EX_TRAINLCD_LOCATION_POLICY_H
+
+#include <math.h>
+
+static inline double EXTrainLCDDistanceFilter(
+  int inBackground,
+  int pausesAutomatically,
+  double configuredDistance,
+  double noDistanceFilter
+) {
+  return inBackground && !pausesAutomatically
+    ? noDistanceFilter
+    : configuredDistance;
+}
+
+// Remaining batch interval in seconds; NSTimer measures the wait independently
+// of subsequent CoreLocation callbacks. Clamp clock reversal to one interval.
+static inline double EXTrainLCDDeferredFlushDelay(double intervalMs, double sampleElapsedSeconds) {
+  if (!isfinite(intervalMs) || intervalMs <= 0) {
+    return 0;
+  }
+  double elapsed = isfinite(sampleElapsedSeconds) && sampleElapsedSeconds > 0
+    ? sampleElapsedSeconds : 0;
+  double remaining = intervalMs / 1000.0 - elapsed;
+  return remaining > 0 ? remaining : 0;
+}
+
+#endif
