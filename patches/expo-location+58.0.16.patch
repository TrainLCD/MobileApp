+// Keep the background-capable manager alive across AppState transitions. A JS timer or
+// foreground watch cannot provide this recovery while the app is suspended.
+- (void)trainLCDDidEnterBackground:(NSNotification *)notification
+{
+  _trainLCDInBackground = YES;
+  [self trainLCDUpdateDistanceFilter];
+  [self maybeReportDeferredLocations];
+}
+
+- (void)trainLCDWillEnterForeground:(NSNotification *)notification
+{
+  _trainLCDInBackground = NO;
+  [self trainLCDUpdateDistanceFilter];
+  [self trainLCDFlushDeferredLocations];
+}
+
+- (void)trainLCDUpdateDistanceFilter
+{
+  if (_locationManager == nil) {
+    return;
+  }
+  // Only background non-power-saving tracking bypasses the displacement gate.
+  // Existing deferred reporting still batches JS delivery by time. Native sampling
+  // may be more frequent; this does not promise unchanged battery consumption.
+  _locationManager.distanceFilter = EXTrainLCDDistanceFilter(
+    _trainLCDInBackground,
+    _locationManager.pausesLocationUpdatesAutomatically,
+    _configuredDistanceFilter,
+    kCLDistanceFilterNone
+  );
+}
+
+// A batch shorter than deferredUpdatesInterval must not wait for another fix.
+// Hold a finite UIKit background task only while an already received batch awaits
+// its one-shot timer. No empty polling or foreground JS watch is started here.
+- (void)trainLCDScheduleDeferredFlush
+{
+  if (!_trainLCDInBackground || _locationManager.pausesLocationUpdatesAutomatically ||
+      _task == nil || _deferredLocations.count == 0 || _trainLCDFlushTimer != nil) {
+    return;
+  }
+  NSDictionary *options = _task.options;
+  double distance = [self numberToDouble:options[@"deferredUpdatesDistance"] defaultValue:0];
+  if (_deferredDistance < distance) {
+    return;
+  }
+  CLLocation *oldest = _lastReportedLocation ?: _deferredLocations.firstObject;
+  CLLocation *newest = _deferredLocations.lastObject;
+  double delay = EXTrainLCDDeferredFlushDelay(
+    [self numberToDouble:options[@"deferredUpdatesInterval"] defaultValue:0],
+    [newest.timestamp timeIntervalSinceDate:oldest.timestamp]
+  );
+  if (delay <= 0) {
+    [self trainLCDFlushDeferredLocations];
+    return;
+  }
+
+  __weak EXLocationTaskConsumer *weakSelf = self;
+  NSTimer *timer = [NSTimer timerWithTimeInterval:delay repeats:NO block:^(NSTimer *firedTimer) {
+    [weakSelf trainLCDFlushDeferredLocations];
+  }];
+  _trainLCDFlushTimer = timer;
+  UIBackgroundTaskIdentifier taskId = [[UIApplication sharedApplication]
+    beginBackgroundTaskWithName:@"TrainLCDLocationBatch"
+    expirationHandler:^{
+      // UIKit does not guarantee the requested time. Flush before ending the task.
+      [weakSelf trainLCDFlushDeferredLocations];
+    }];
+  // Expiration can cancel the pending flush before beginBackgroundTask returns.
+  if (_trainLCDFlushTimer != timer) {
+    if (taskId != UIBackgroundTaskInvalid) {
+      [[UIApplication sharedApplication] endBackgroundTask:taskId];
+    }
+    return;
+  }
+  _trainLCDFlushTaskId = taskId;
+  if (taskId == UIBackgroundTaskInvalid) {
+    [self trainLCDFlushDeferredLocations];
+    return;
+  }
+  [[NSRunLoop mainRunLoop] addTimer:timer forMode:NSRunLoopCommonModes];
+}
+
+- (void)trainLCDCancelDeferredFlush
+{
+  [_trainLCDFlushTimer invalidate];
+  _trainLCDFlushTimer = nil;
+  UIBackgroundTaskIdentifier taskId = _trainLCDFlushTaskId;
+  _trainLCDFlushTaskId = UIBackgroundTaskInvalid;
+  if (taskId != UIBackgroundTaskInvalid) {
+    [[UIApplication sharedApplication] endBackgroundTask:taskId];
+  }
+}
+
+- (void)trainLCDFlushDeferredLocations
+{
+  if (_task != nil && _deferredLocations.count > 0) {
+    [self executeTaskWithDeferredLocations];
+  } else {
+    [self trainLCDCancelDeferredFlush];
+  }
+}
+
