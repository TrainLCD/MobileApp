+  _trainLCDHeartbeatTimer = nil;
+  if (![self trainLCDCanRecover] || _trainLCDRecoveryManager != nil) {
+    [self trainLCDRecordDiagnostic:@"start-skipped" details:@{}];
+    return;
+  }
+  [self trainLCDRecordDiagnostic:@"requested" details:@{}];
+  // A separate background-capable manager leaves the main 10m filter unchanged.
+  CLLocationManager *manager = [CLLocationManager new];
+  _trainLCDRecoveryManager = manager;
+  manager.delegate = self;
+  manager.allowsBackgroundLocationUpdates = YES;
+  manager.desiredAccuracy = _locationManager.desiredAccuracy;
+  manager.activityType = _locationManager.activityType;
+  manager.showsBackgroundLocationIndicator = _locationManager.showsBackgroundLocationIndicator;
+  manager.pausesLocationUpdatesAutomatically = NO;
