+++ b/node_modules/expo-location/ios/TaskConsumers/EXTrainLCDLocationPolicy.h
@@ -0,0 +1,49 @@
+// TrainLCD: keep the configured foreground and power-saving distance filters.
+#ifndef EX_TRAINLCD_LOCATION_POLICY_H
+#define EX_TRAINLCD_LOCATION_POLICY_H
+
+#include <math.h>
+
+static inline double EXTrainLCDDistanceFilter(
+  int inBackground,
+  int bypassDistanceFilter,
+  int pausesAutomatically,
+  double configuredDistance,
+  double noDistanceFilter
+) {
+  return bypassDistanceFilter && inBackground && !pausesAutomatically
+    ? noDistanceFilter
+    : configuredDistance;
+}
+
+// Remaining batch interval in seconds; NSTimer measures the wait independently
+// of subsequent CoreLocation callbacks. Clamp clock reversal to one interval.
+static inline double EXTrainLCDDeferredFlushDelay(double intervalMs, double sampleElapsedSeconds) {
+  if (!isfinite(intervalMs) || intervalMs <= 0) {
+    return 0;
+  }
+  double elapsed = isfinite(sampleElapsedSeconds) && sampleElapsedSeconds > 0
+    ? sampleElapsedSeconds : 0;
+  double remaining = intervalMs / 1000.0 - elapsed;
+  return remaining > 0 ? remaining : 0;
+}
+
+// Monotonic deadlines are independent of wall-clock changes and batched delivery.
+static inline double EXTrainLCDHeartbeatDelay(double now, double lastFresh, double retryAfter, double interval) {
+  double deadline = fmax(lastFresh + interval, retryAfter);
+  return fmax(0, deadline - now);
+}
+
+static inline int EXTrainLCDHeartbeatSampleIsFresh(double timestamp, double previous, double wallNow, double interval) {
+  return isfinite(timestamp) && isfinite(wallNow) && timestamp <= wallNow &&
+    wallNow - timestamp < interval &&
+    (timestamp > previous || previous > wallNow);
+}
+
+static inline int EXTrainLCDHeartbeatEnabled(int background, int pauses, int lowPower,
+  double distanceFilter, double interval, double timeout) {
+  return background && !pauses && !lowPower && distanceFilter > 0 &&
+    isfinite(interval) && interval > 0 && isfinite(timeout) && timeout > 0;
+}
+
+#endif
