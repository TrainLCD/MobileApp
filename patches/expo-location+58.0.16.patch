+    @"distanceFilter": @(_locationManager.distanceFilter),
+    @"intervalMs": @(_trainLCDHeartbeatInterval * 1000),
+    @"timeoutMs": @(_trainLCDHeartbeatTimeout * 1000),
+  } mutableCopy];
+  [entry addEntriesFromDictionary:details];
+  NSDictionary *immutableEntry = [entry copy];
+  trainLCDDiagnosticCounts[event] = @([trainLCDDiagnosticCounts[event] unsignedLongLongValue] + 1);
+  trainLCDLastDiagnosticEvents[event] = immutableEntry;
+  [trainLCDDiagnosticEvents addObject:immutableEntry];
+  if (trainLCDDiagnosticEvents.count > 40) {
