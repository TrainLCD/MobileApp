+// A batch shorter than deferredUpdatesInterval must not wait for another fix.
+// Hold a finite UIKit background task only while an already received batch awaits
+// its one-shot timer. No empty polling or foreground JS watch is started here.
+- (void)trainLCDScheduleDeferredFlush
+{
+  if (!_trainLCDInBackground || _locationManager.pausesLocationUpdatesAutomatically ||
+      _task == nil || _deferredLocations.count == 0 || _trainLCDFlushTimer != nil) {
+    return;
+  }
+  NSDictionary *options = _task.options;
+  double distance = [self numberToDouble:options[@"deferredUpdatesDistance"] defaultValue:0];
+  if (_deferredDistance < distance) {
+    return;
+  }
+  CLLocation *oldest = _lastReportedLocation ?: _deferredLocations.firstObject;
+  CLLocation *newest = _deferredLocations.lastObject;
+  double delay = EXTrainLCDDeferredFlushDelay(
+    [self numberToDouble:options[@"deferredUpdatesInterval"] defaultValue:0],
+    [newest.timestamp timeIntervalSinceDate:oldest.timestamp]
+  );
+  if (delay <= 0) {
+    [self trainLCDFlushDeferredLocations];
+    return;
+  }
+
+  __weak EXLocationTaskConsumer *weakSelf = self;
+  NSTimer *timer = [NSTimer timerWithTimeInterval:delay repeats:NO block:^(NSTimer *firedTimer) {
+    [weakSelf trainLCDFlushDeferredLocations];
+  }];
+  _trainLCDFlushTimer = timer;
+  UIBackgroundTaskIdentifier taskId = [[UIApplication sharedApplication]
+    beginBackgroundTaskWithName:@"TrainLCDLocationBatch"
+    expirationHandler:^{
+      // UIKit does not guarantee the requested time. Flush before ending the task.
+      [weakSelf trainLCDFlushDeferredLocations];
+    }];
+  // Expiration can cancel the pending flush before beginBackgroundTask returns.
+  if (_trainLCDFlushTimer != timer) {
