+  __weak EXLocationTaskConsumer *weakSelf = self;
+  UIBackgroundTaskIdentifier taskId = [[UIApplication sharedApplication]
+    beginBackgroundTaskWithName:@"TrainLCDLocationRecovery" expirationHandler:^{
+      EXLocationTaskConsumer *strongSelf = weakSelf;
+      if (strongSelf != nil && strongSelf->_trainLCDRecoveryManager == manager) {
+        [strongSelf trainLCDRecordDiagnostic:@"expired" details:@{}];
