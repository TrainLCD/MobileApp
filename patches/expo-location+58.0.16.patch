+- (void)trainLCDRecordDiagnostic:(NSString *)event details:(NSDictionary *)details
+{
+  if (trainLCDDiagnosticCounts == nil) {
+    trainLCDDiagnosticCounts = [NSMutableDictionary new];
+    trainLCDLastDiagnosticEvents = [NSMutableDictionary new];
+    trainLCDDiagnosticEvents = [NSMutableArray new];
+  }
