+    @"event": event,
+    @"atMs": @(NSDate.date.timeIntervalSince1970 * 1000),
+    @"uptimeMs": @(NSProcessInfo.processInfo.systemUptime * 1000),
+    @"taskName": _task.name ?: (id)NSNull.null,
+    @"taskRegistered": @(_task != nil),
+    @"managerPresent": @(_locationManager != nil),
+    @"inBackground": @(_trainLCDInBackground),
+    @"recoveryActive": @(_trainLCDRecoveryManager != nil),
