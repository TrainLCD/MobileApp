+// Keep the background-capable manager alive across AppState transitions. A JS timer or
+// foreground watch cannot provide this recovery while the app is suspended.
+- (void)trainLCDDidEnterBackground:(NSNotification *)notification
+{
+  _trainLCDInBackground = YES;
+  [self trainLCDUpdateDistanceFilter];
+}
+
+- (void)trainLCDWillEnterForeground:(NSNotification *)notification
+{
+  _trainLCDInBackground = NO;
+  [self trainLCDUpdateDistanceFilter];
+}
+
+- (void)trainLCDUpdateDistanceFilter
+{
+  if (_locationManager == nil) {
+    return;
+  }
+  // Only background non-power-saving tracking bypasses the displacement gate.
+  // Existing deferred reporting still batches JS delivery by time. Native sampling
+  // may be more frequent; this does not promise unchanged battery consumption.
+  _locationManager.distanceFilter = EXTrainLCDDistanceFilter(
+    _trainLCDInBackground,
+    _locationManager.pausesLocationUpdatesAutomatically,
+    _configuredDistanceFilter,
+    kCLDistanceFilterNone
+  );
+}
