# put-secrets.sh 用のシークレット値テンプレート。
# このファイルをコピーして .secrets.env（または .secrets.prod.env）を作り、値を埋める。
# .secrets* は gitignore 済み。絶対にコミットしないこと。
#
#   cp .secrets.env.example .secrets.env
#   ./scripts/put-secrets.sh                 # dev
#   ./scripts/put-secrets.sh --env production # prod（.secrets.prod.env を使うなら SECRETS_FILE=... を併用）

SESSION_JWT_SECRET=
AZURE_SPEECH_KEY=
# GOOGLE_PLAY_SA_KEY はここに 1 行 JSON を入れてもよいが、複数行 JSON は
# GOOGLE_PLAY_SA_KEY_FILE=./sa.json ./scripts/put-secrets.sh の方が扱いやすい。
GOOGLE_PLAY_SA_KEY=
OCTOKIT_PAT=
DISCORD_CS_WEBHOOK_URL=
DISCORD_CRASH_WEBHOOK_URL=
DISCORD_REVIEW_WEBHOOK_URL=
