{
  "name": "functions",
  "scripts": {
    "dev": "wrangler dev",
    "deploy:dev": "wrangler deploy",
    "deploy:prod": "wrangler deploy --env production",
    "tail": "wrangler tail",
    "tail:prod": "wrangler tail --env production",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "biome check ./src",
    "format": "biome format ./src --write",
    "cf-typegen": "wrangler types",
    "find-tts-cache": "tsx src/cli/find-tts-cache.ts",
    "find-orphaned-tts": "tsx src/cli/find-orphaned-tts.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "dayjs": "^1.11.9"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.0",
    "@cloudflare/workers-types": "^4.20240000.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "aws4fetch": "^1.0.20",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.22.4",
    "typescript": "^5.6.0",
    "wrangler": "^4.100.0"
  },
  "private": true
}
