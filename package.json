    "react-native-view-shot": "6.1.1",
    "react-native-watch-connectivity": "^1.1.0",
    "react-native-web": "^0.21.4",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@biomejs/biome": "2.0.0",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-operations": "^6.1.10",
    "@react-native-community/cli": "^20.1.0",
    "@react-native/jest-preset": "^0.88.0",
    "@react-native/js-polyfills": "^0.88.0",
    "@react-native/metro-config": "^0.88.0",
    "@testing-library/jest-native": "^4.0.11",
    "@testing-library/react-native": "^13.2.0",
    "@types/i18n-js": "^3.0.1",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.14.161",
    "@types/node": "^20.19.0",
    "@types/react": "~19.3.0",
    "@types/react-native-share": "^3.3.1",
    "@types/react-native-version-check": "^3.4.8",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "~58.0.16",
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.11",
    "patch-package": "^8.0.1",
    "react-native-dotenv": "^3.4.8",
    "react-native-worklets": "0.13.0",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "engines": {
    "npm": ">=11"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      },
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-version-check",
          "react-native-watch-connectivity"
        ]
      }
    },
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-speech"
        ]
      }
    },
    "install": {
      "exclude": [
        "jest",
        "@types/jest"
      ]
    }
  },
  "overrides": {
    "react-native-skeleton-placeholder": {
      "@react-native-masked-view/masked-view": "0.3.2"
    }
  },
  "name": "trainlcd",
  "version": "10.19.1"
}
