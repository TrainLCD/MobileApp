{
  "scripts": {
    "start": "expo start",
    "android": "cross-env APP_VARIANT=dev expo run:android -- --variant devDebug",
    "ios": "cross-env APP_VARIANT=dev expo run:ios",
    "web": "expo start --web",
    "lint": "biome check ./src",
    "format": "biome format ./src --write",
    "test": "cross-env TZ=UTC jest",
    "typecheck": "tsc --noEmit",
    "watch:test": "cross-env TZ=UTC jest --watch",
    "gql:codegen": "graphql-codegen --config utils/codegen.ts",
    "version:bump": "node scripts/bump-version.js",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo-google-fonts/roboto": "^0.2.3",
    "@expo/react-native-action-sheet": "^4.1.1",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/portal": "^1.0.14",
    "@holiday-jp/holiday_jp": "^2.5.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.3.1",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.101.0",
    "dayjs": "^1.11.19",
    "expo": "^57.0.12",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.10",
    "expo-audio": "~57.0.3",
    "expo-battery": "~57.0.1",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.10",
    "expo-constants": "~57.0.10",
    "expo-crypto": "~57.0.1",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-insights": "~57.0.9",
    "expo-keep-awake": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-localization": "~57.0.1",
    "expo-location": "~57.0.9",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.10",
    "expo-quick-actions": "^6.0.1",
    "expo-screen-capture": "~57.0.1",
    "expo-screen-orientation": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-speech": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-sqlite": "~57.0.1",
    "expo-task-manager": "~57.0.9",
    "expo-web-browser": "~57.0.2",
    "geolib": "^3.3.4",
    "graphql": "^16.11.0",
    "graphql-request": "^6.1.0",
    "graphql-tag": "^2.12.6",
    "i18n-js": "^3.5.1",
    "jotai": "^2.12.4",
    "lodash": "^4.18.1",
    "polished": "^4.1.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-error-boundary": "^4.0.4",
    "react-native": "0.86.2",
    "react-native-app-clip": "^0.5.1",
    "react-native-device-info": "^10.2.1",
    "react-native-edge-to-edge": "^1.3.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-localize": "^3.3.0",
    "react-native-mmkv": "^4.3.1",
    "react-native-nitro-modules": "^0.35.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-share": "^11.1.0",
    "react-native-skeleton-placeholder": "^5.2.4",
    "react-native-svg": "15.15.4",
    "react-native-toast-message": "^2.3.3",
    "react-native-version-check": "^3.4.7",
    "react-native-view-shot": "5.1.0",
    "react-native-watch-connectivity": "^1.1.0",
    "react-native-web": "^0.21.1",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@babel/core": "^7.19.3",
    "@biomejs/biome": "2.0.0",
    "@graphql-codegen/cli": "^6.0.0",
    "@graphql-codegen/typescript": "^5.0.2",
    "@graphql-codegen/typescript-operations": "^5.0.2",
    "@react-native-community/cli": "^20.1.0",
    "@react-native/js-polyfills": "^0.86.2",
    "@react-native/metro-config": "^0.86.2",
    "@testing-library/jest-native": "^4.0.11",
    "@testing-library/react-native": "^13.2.0",
    "@types/i18n-js": "^3.0.1",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.14.161",
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.14",
    "@types/react-native-share": "^3.3.1",
    "@types/react-native-version-check": "^3.4.8",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "~57.0.6",
    "cross-env": "^10.1.0",
    "jest": "^29.2.1",
    "jest-expo": "~57.0.4",
    "patch-package": "^8.0.1",
    "react-native-dotenv": "^3.4.8",
    "react-native-worklets": "0.10.1",
    "typescript": "~6.0.3"
  },
  "private": true,
  "engines": {
    "npm": ">=11"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      },
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-version-check",
          "react-native-watch-connectivity"
        ]
      }
    }
  },
  "jest": {
    "preset": "jest-expo",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node",
      "d.ts"
    ],
    "watchman": false,
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "^~/(.*)$": "<rootDir>/src/$1",
      "^~/@types/graphql$": "<rootDir>/src/@types/graphql.ts",
      "^react-native-reanimated/mock$": "<rootDir>/src/__mocks__/react-native-reanimated-mock.js"
    }
  },
  "overrides": {
    "react-native-skeleton-placeholder": {
      "@react-native-masked-view/masked-view": "0.3.2"
    }
  },
  "name": "trainlcd",
  "version": "10.13.0"
}
