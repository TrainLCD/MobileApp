    "lodash": "^4.18.1",
    "polished": "^4.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-error-boundary": "^4.0.4",
    "react-native": "0.88.0",
    "react-native-app-clip": "^0.5.1",
    "react-native-device-info": "^10.2.1",
    "react-native-edge-to-edge": "^1.3.1",
