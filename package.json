{
  "scripts": {
    "start": "expo start",
    "android": "cross-env APP_VARIANT=dev expo run:android -- --variant devDebug --app-id me.tinykitten.trainlcd.dev",
    "android:local": "cross-env APP_VARIANT=local expo run:android -- --variant localDebug --app-id me.tinykitten.trainlcd.local",
    "ios": "npm run ios:frameworks && cross-env APP_VARIANT=dev expo run:ios",
    "ios:frameworks": "node scripts/fetch-voicevox-frameworks.mjs",
    "web": "expo start --web",
    "lint": "biome check ./src && node scripts/lint-animated-text.mjs",
    "format": "biome format ./src --write",
    "test": "cross-env TZ=UTC jest",
    "test:scripts": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON --test .github/scripts/*.test.mjs scripts/*.test.mjs",
    "test:lint": "node --test scripts/lint-tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "watch:test": "cross-env TZ=UTC jest --watch",
    "gql:codegen": "graphql-codegen --config utils/codegen.ts",
    "gpx:generate": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-location-gpx.mjs",
    "gpx:replay": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/replay-location-gpx.mjs",
    "version:bump": "node scripts/bump-version.js",
    "eas-build-pre-install": "node scripts/eas-restore-google-services.mjs",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo-google-fonts/roboto": "^0.2.3",
    "@expo/react-native-action-sheet": "^4.1.1",
    "@expo/vector-icons": "^15.0.3",
